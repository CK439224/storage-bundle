<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission policy (PLAN.md §6):

  * There is deliberately NO android.permission.INTERNET. The app makes no network calls,
    and `checkReleaseNoNetworkPermission` fails the build if any dependency reintroduces one.
  * Media permissions are split by API level. On 33+ READ_MEDIA_IMAGES is required because
    both media features need whole-library visibility; the Photo Picker cannot audit a
    library it can only see one selection of.
  * Every permission is requested at first use of its feature, never at launch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ (API 33+) -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />

    <!-- Android 11-12L (API 30-32) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Drift alerts only; requested when the user enables that feature (v0.3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Enumerating installed apps IS the Permission Drift Tracker, so <queries> cannot
      substitute. Feature-flagged so a future Play build can ship without it (PLAN.md §5.3).
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Defence in depth: if a transitive dependency ever contributes a network permission,
      strip it at merge time. The build check is the gate; this is the backstop.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".StorageBundleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StorageBundle"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StorageBundle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hilt supplies WorkManager's factory, so the default initialiser is removed and
          WorkManager is initialised on demand by the Application class.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
